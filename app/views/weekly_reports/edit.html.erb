<div class="report-container">

  <%= render "shared/breadcrumbs", breadcrumbs: [
    { label: "Weekly Reports", path: weekly_reports_path(project_id: @weekly_report.project_id) },
    { label: "Report ##{@weekly_report.report_number}", path: weekly_report_path(@weekly_report) },
    { label: "Edit", path: "#" }
  ] %>

  <% if @weekly_report.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@weekly_report.errors.count, "error") %> prohibited this weekly report from being saved:</h4>
      <ul>
        <% @weekly_report.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="report-header">
    <div class="header-title">
      <div>
        <h1>Edit FAA Weekly Report #<%= @weekly_report.report_number %></h1>
        <span class="status-badge status-<%= @weekly_report.status %>">
          <%= @weekly_report.status.humanize %>
        </span>
      </div>
    </div>
  </div>

  <%= form_with(model: @weekly_report, local: true, class: "report-form-layout") do |f| %>

    <%# ─── Section 2: Weather ─── %>
    <div class="table-card">
      <h3 class="mt-0">2. Brief Weather Summary this Period</h3>
      <% weather = @weekly_report.weather_data_json || {} %>
      <% if weather.any? && weather["temp_high"].present? %>
        <div class="meta-data-grid" style="margin-bottom: 12px;">
          <div class="meta-item">
            <label>Temp High</label>
            <div class="value"><%= weather["temp_high"] %>°F</div>
          </div>
          <div class="meta-item">
            <label>Temp Low</label>
            <div class="value"><%= weather["temp_low"] %>°F</div>
          </div>
          <div class="meta-item">
            <label>Avg Wind</label>
            <div class="value"><%= weather["wind_avg"] %> mph</div>
          </div>
          <div class="meta-item">
            <label>Precip Total</label>
            <div class="value"><%= weather["precip_total"] %>"</div>
          </div>
        </div>
      <% end %>
      <div class="form-group">
        <label class="form-label">Weather Narrative</label>
        <%= f.text_area :weather_summary, class: "form-input", rows: 5,
            placeholder: "AI-generated from daily report weather data. Edit as needed..." %>
        <small class="text-muted">This section is auto-generated by AI from aggregated weather data. You may edit it before export.</small>
      </div>
    </div>

    <%# ─── Section 3: Completion (read-only) ─── %>
    <div class="table-card">
      <h3 class="mt-0">3. Rough Estimate of Percent Completion to Date</h3>
      <% categories = @weekly_report.category_completions %>
      <% if categories.any? %>
        <div class="section-content">
          <%= simple_format(@weekly_report.completion_narrative) %>
        </div>
        <small class="text-muted">This section is auto-computed from the Data View. Click "Aggregate Data" on the show page to refresh.</small>
      <% else %>
        <p class="text-muted"><em>Not yet computed. Click "Aggregate Data" on the show page.</em></p>
      <% end %>
    </div>

    <%# ─── Section 4: Work Summary ─── %>
    <div class="table-card">
      <h3 class="mt-0">4. Work Completed or In Progress this Period</h3>
      <div class="form-group">
        <label class="form-label">Work Summary</label>
        <%= f.text_area :work_summary, class: "form-input", rows: 12,
            placeholder: "AI-generated from daily report commentary, grouped by category. Edit as needed..." %>
      </div>
    </div>

    <%# ─── Section 5a: Lab Testing ─── %>
    <div class="table-card">
      <h3 class="mt-0">5a. Summary of Laboratory and Field Testing this Period</h3>
      <div class="form-group">
        <label class="form-label">Lab/Field Testing Summary</label>
        <%= f.text_area :lab_testing_summary, class: "form-input", rows: 8,
            placeholder: "AI-generated from QA entry data. Edit as needed..." %>
      </div>
    </div>

    <%# ─── Section 5b: Materials ─── %>
    <div class="table-card">
      <h3 class="mt-0">5b. Material (subject to pay reduction)</h3>
      <div class="form-group">
        <label class="form-label">Materials Summary</label>
        <%= f.text_area :materials_summary, class: "form-input", rows: 6,
            placeholder: "AI-generated from failed/out-of-tolerance QA results. Edit as needed..." %>
      </div>
    </div>

    <%# ─── Section 7: Problem Areas ─── %>
    <div class="table-card">
      <h3 class="mt-0">7. Problem Areas / Other Comments</h3>
      <div class="form-group">
        <label class="form-label">Problem Areas & Comments</label>
        <%= f.text_area :problem_areas, class: "form-input", rows: 10,
            placeholder: "AI-generated from deficiencies and safety incidents. Edit as needed..." %>
      </div>
    </div>

    <%# ─── Status ─── %>
    <div class="table-card">
      <h3 class="mt-0">Report Status</h3>
      <div class="form-group">
        <label class="form-label">Status</label>
        <%= f.select :status, WeeklyReport.statuses.keys.map { |s| [s.humanize, s] },
            {}, class: "form-input" %>
      </div>
    </div>

    <div class="form-actions" style="margin-top: 20px; margin-bottom: 40px;">
      <%= f.submit "Save Changes", class: "btn btn-primary" %>
      <%= link_to "Cancel", weekly_report_path(@weekly_report), class: "btn btn-clear" %>
    </div>

  <% end %>

</div>
