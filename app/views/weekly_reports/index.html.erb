<div class="dashboard-container">

  <div class="page-header">
    <div class="page-header-left">
      <h1 class="page-title">FAA Weekly Reports</h1>
      <span class="page-header-sep">|</span>
      <%= form_with url: weekly_reports_path, method: :get, local: true, class: "context-form" do |f| %>
        <%= f.collection_select :project_id, @projects, :id, :name,
            { include_blank: "All Projects", selected: params[:project_id] },
            { onchange: "this.form.submit()", class: "project-select-compact" } %>
        <%= f.hidden_field :week_ending, value: @week_ending %>
      <% end %>
    </div>
    <div class="page-header-right">
      <%= link_to "← Reports", reports_path(project_id: params[:project_id]), class: "btn btn-clear btn-sm" %>
    </div>
  </div>

  <% if notice %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>
  <% if alert %>
    <div class="alert alert-danger"><%= alert %></div>
  <% end %>

  <%# ─── Week selector bar ─── %>
  <div class="table-card" style="padding: 12px 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">

      <div style="display: flex; align-items: center; gap: 12px;">
        <%= form_with url: weekly_reports_path, method: :get, local: true, class: "context-form" do |f| %>
          <%= f.hidden_field :project_id, value: params[:project_id] %>
          <%= f.select :week_ending,
              options_for_select(@week_options, @week_ending.to_s),
              {},
              { class: "project-select-compact", onchange: "this.form.submit()" } %>
        <% end %>

        <div class="text-muted text-sm">
          <%= @week_start.strftime("%m/%d/%Y") %> – <%= @week_ending.strftime("%m/%d/%Y") %>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;">
        <% if @existing_weekly_report %>
          <%= link_to "View Weekly Report ##{@existing_weekly_report.report_number}",
              weekly_report_path(@existing_weekly_report),
              class: "btn btn-secondary btn-sm" %>
        <% elsif @project %>
          <%= form_with url: weekly_reports_path, method: :post, local: true, style: "display: inline;" do |f| %>
            <%= f.hidden_field :weekly_report, value: nil, name: nil %>
            <input type="hidden" name="weekly_report[project_id]" value="<%= @project.id %>">
            <input type="hidden" name="weekly_report[start_date]" value="<%= @week_start %>">
            <input type="hidden" name="weekly_report[end_date]" value="<%= @week_ending %>">
            <%= f.submit "New Weekly Report", class: "btn btn-primary btn-sm" %>
          <% end %>
        <% else %>
          <span class="text-muted text-sm">Select a project to create a weekly report</span>
        <% end %>
      </div>

    </div>
  </div>

  <%# ─── Daily reports table for selected week ─── %>
  <div class="table-card table-card-scroll">
    <table class="modern-table dashboard-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Inspector</th>
          <th>Project</th>
          <th>Phase</th>
          <th>Result</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @reports.any? %>
          <% @reports.each do |report| %>
            <tr class="clickable-row">
              <td class="cell-primary"><%= report.start_date&.strftime("%b %d") %></td>
              <td class="font-medium"><%= report.user.email.split('@').first.titleize %></td>
              <td class="cell-secondary"><%= report.project&.name || "-" %></td>
              <td class="cell-secondary"><%= report.phase&.name || "-" %></td>
              <td>
                <% if report.result == 'pass' %>
                  <span class="text-success">Pass</span>
                <% elsif report.result == 'fail' %>
                  <span class="text-danger">Fail</span>
                <% else %>
                  <span class="text-muted">Pending</span>
                <% end %>
              </td>
              <td class="text-right"><%= link_to "View", report_path(report), class: "link-primary" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted" style="padding: 30px;">
              No finalized reports for this week.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ─── All weekly reports table ─── %>
  <div class="table-card table-card-scroll" style="margin-top: 16px;">
    <h3 class="mt-0 mb-3">All Weekly Reports</h3>
    <table class="modern-table dashboard-table">
      <thead>
        <tr>
          <th>Week Ending</th>
          <th>Week</th>
          <th>Project</th>
          <th>Status</th>
          <th>Completion</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @weekly_reports.any? %>
          <% @weekly_reports.each do |weekly| %>
            <tr>
              <td class="cell-primary"><%= weekly.end_date.strftime("%b %d, %Y") %></td>
              <td>Week <%= weekly.report_number || "-" %></td>
              <td class="cell-secondary"><%= weekly.project&.name || "-" %></td>
              <td><span class="status-badge status-<%= weekly.status %>"><%= weekly.status.humanize %></span></td>
              <td><%= weekly.overall_completion_pct %>%</td>
              <td class="text-right"><%= link_to "View", weekly_report_path(weekly), class: "link-primary" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted" style="padding: 30px;">
              No weekly reports created yet.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

</div>
