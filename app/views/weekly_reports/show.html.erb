<div class="report-container"
     data-controller="weekly-ai-status"
     data-weekly-ai-status-weekly-report-id-value="<%= @weekly_report.id %>"
     data-weekly-ai-status-ai-status-value="<%= @weekly_report.ai_status %>">

  <%= render "shared/breadcrumbs", breadcrumbs: [
    { label: "Weekly Reports", path: weekly_reports_path(project_id: @weekly_report.project_id) },
    { label: "Report ##{@weekly_report.report_number}", path: "#" }
  ] %>

  <% if notice %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>
  <% if alert %>
    <div class="alert alert-danger"><%= alert %></div>
  <% end %>

  <% if @weekly_report.ai_generating? %>
    <div class="alert alert-info">
      ⏳ AI generation in progress… Sections will populate automatically. This page will refresh when complete.
    </div>
  <% end %>
  <% if @weekly_report.ai_status == 'failed' %>
    <div class="alert alert-danger">
      ❌ AI generation failed: <%= @weekly_report.ai_error %>. You can retry by clicking "Generate AI Summaries" or edit sections manually.
    </div>
  <% end %>

  <div class="report-header">
    <div class="header-title">
      <div>
        <h1>FAA Weekly Report #<%= @weekly_report.report_number %></h1>
        <span class="status-badge status-<%= @weekly_report.status %>">
          <%= @weekly_report.status.humanize %>
        </span>
      </div>

      <div class="actions">
        <% if @weekly_report.draft? || @weekly_report.generated? %>
          <%= link_to "Edit Sections", edit_weekly_report_path(@weekly_report), class: "btn btn-secondary" %>
        <% end %>

        <% unless @weekly_report.ai_generating? %>
          <%= button_to "Generate AI Summaries", generate_weekly_report_path(@weekly_report), method: :post, class: "btn btn-primary" %>
        <% else %>
          <button class="btn btn-primary" disabled>⏳ Generating…</button>
        <% end %>

        <%= link_to "Back", weekly_reports_path(project_id: @weekly_report.project_id), class: "btn btn-clear" %>

        <% if @weekly_report.generated? || @weekly_report.finalized? %>
          <%= button_to "Export DOCX", export_weekly_report_path(@weekly_report), method: :post, class: "btn btn-primary", data: { turbo: false } %>
        <% end %>
      </div>
    </div>

    <div class="meta-data-grid">
      <div class="meta-item">
        <label>Project</label>
        <div class="value"><%= @weekly_report.project&.name %></div>
      </div>
      <div class="meta-item">
        <label>Period</label>
        <div class="value"><%= @weekly_report.period_label %></div>
      </div>
      <div class="meta-item">
        <label>Contract Number</label>
        <div class="value"><%= @weekly_report.project&.contract_number %></div>
      </div>
      <div class="meta-item">
        <label>Contractor</label>
        <div class="value"><%= @weekly_report.project&.prime_contractor || "—" %></div>
      </div>
    </div>
  </div>

  <%# ─── Section 1: Contract Time ─── %>
  <div class="report-section">
    <h3 class="mt-0">1. Contract Time</h3>
    <div class="meta-data-grid">
      <div class="meta-item">
        <label>Contract Time</label>
        <div class="value"><%= @weekly_report.contract_time %> Calendar Days</div>
      </div>
      <div class="meta-item">
        <label>No. Days Charged to Date</label>
        <div class="value"><strong><%= @weekly_report.days_charged %></strong></div>
      </div>
      <div class="meta-item">
        <label>Last Working Day Charged</label>
        <div class="value"><%= @weekly_report.last_working_day_formatted %></div>
      </div>
    </div>
  </div>

  <%# ─── Section 2: Weather ─── %>
  <div class="report-section">
    <h3 class="mt-0">2. Brief Weather Summary this Period</h3>
    <% weather = @weekly_report.weather_data_json || {} %>
    <% if weather.any? && weather["temp_high"].present? %>
      <div class="meta-data-grid" style="margin-bottom: 12px;">
        <div class="meta-item">
          <label>Temp High</label>
          <div class="value"><%= weather["temp_high"] %>°F</div>
        </div>
        <div class="meta-item">
          <label>Temp Low</label>
          <div class="value"><%= weather["temp_low"] %>°F</div>
        </div>
        <div class="meta-item">
          <label>Avg Wind</label>
          <div class="value"><%= weather["wind_avg"] %> mph</div>
        </div>
        <div class="meta-item">
          <label>Precip Total</label>
          <div class="value"><%= weather["precip_total"] %>"</div>
        </div>
      </div>
    <% end %>
    <div class="section-content">
      <% if @weekly_report.weather_summary.present? %>
        <%= simple_format(@weekly_report.weather_summary) %>
      <% else %>
        <p class="text-muted"><em>Not yet generated. Click "Generate AI Summaries" to auto-populate.</em></p>
      <% end %>
    </div>
  </div>

  <%# ─── Section 3: Completion ─── %>
  <div class="report-section">
    <h3 class="mt-0">3. Rough Estimate of Percent Completion to Date</h3>
    <% categories = @weekly_report.category_completions %>
    <% if categories.any? %>
      <p>Estimated percent completion is <strong><%= @weekly_report.overall_completion_pct %>%</strong>.</p>
      <ul style="margin-top: 8px;">
        <% categories.each do |cat| %>
          <li><strong><%= cat[:name] %></strong>: <%= cat[:percent] %>%</li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-muted"><em>Not yet computed. Click "Generate AI Summaries" to calculate.</em></p>
    <% end %>
  </div>

  <%# ─── Section 4: Work Summary ─── %>
  <div class="report-section">
    <h3 class="mt-0">4. Work Completed or In Progress this Period</h3>
    <div class="section-content">
      <% if @weekly_report.work_summary.present? %>
        <%= simple_format(@weekly_report.work_summary) %>
      <% else %>
        <p class="text-muted"><em>Not yet generated. Click "Generate AI Summaries" to auto-populate.</em></p>
      <% end %>
    </div>
  </div>

  <%# ─── Section 5a: Lab Testing ─── %>
  <div class="report-section">
    <h3 class="mt-0">5a. Summary of Laboratory and Field Testing this Period</h3>
    <div class="section-content">
      <% if @weekly_report.lab_testing_summary.present? %>
        <%= simple_format(@weekly_report.lab_testing_summary) %>
      <% else %>
        <p class="text-muted"><em>Not yet generated. Click "Generate AI Summaries" to auto-populate.</em></p>
      <% end %>
    </div>
  </div>

  <%# ─── Section 5b: Materials ─── %>
  <div class="report-section">
    <h3 class="mt-0">5b. Material (subject to pay reduction)</h3>
    <div class="section-content">
      <% if @weekly_report.materials_summary.present? %>
        <%= simple_format(@weekly_report.materials_summary) %>
      <% else %>
        <p class="text-muted"><em>Not yet generated. Click "Generate AI Summaries" to auto-populate.</em></p>
      <% end %>
    </div>
  </div>

  <%# ─── Section 7: Problem Areas ─── %>
  <div class="report-section">
    <h3 class="mt-0">7. Problem Areas / Other Comments</h3>
    <div class="section-content">
      <% if @weekly_report.problem_areas.present? %>
        <%= simple_format(@weekly_report.problem_areas) %>
      <% else %>
        <p class="text-muted"><em>Not yet generated. Click "Generate AI Summaries" to auto-populate.</em></p>
      <% end %>
    </div>
  </div>

  <%# ─── Authorized Reports in Period ─── %>
  <div class="report-section">
    <h3 class="mt-0">Source: Authorized Daily Reports in Period</h3>
    <% source_reports = @weekly_report.authorized_reports.includes(:user).order(:start_date) %>
    <% if source_reports.any? %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Inspector</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% source_reports.each do |r| %>
            <tr>
              <td><%= link_to r.start_date.strftime("%b %d, %Y"), report_path(r), class: "text-link", target: "_blank" %></td>
              <td><%= r.user&.email %></td>
              <td>
                <span class="status-badge status-<%= r.status %>"><%= r.status_label %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-muted">No authorized daily reports found for this period.</p>
    <% end %>
  </div>

  <%# ─── Danger zone ─── %>
  <div class="report-section" style="border-color: var(--danger);">
    <h3 class="mt-0" style="color: var(--danger);">Danger Zone</h3>
    <p class="text-muted" style="margin-bottom: 0.75rem;">Permanently deletes this weekly report and all AI-generated content. This action cannot be undone.</p>
    <%= button_to "Delete Weekly Report", weekly_report_path(@weekly_report),
        method: :delete,
        class: "btn btn-danger",
        data: { turbo_confirm: "Are you sure you want to permanently delete this weekly report? This cannot be undone." } %>
  </div>

</div>
