<div class="dashboard-container">
  <div class="dashboard-header">
    <h1>Core Locations</h1>
    <div class="d-flex gap-3">
      <%= link_to "Back to Lot", project_asphalt_lot_path(@project, @asphalt_lot), class: "btn btn-secondary" %>
      <%= link_to "Generate Again", new_project_asphalt_lot_core_generation_path(@project, @asphalt_lot), class: "btn btn-secondary" %>
      <%= link_to "Export Excel",
            export_xlsx_project_asphalt_lot_core_generation_path(@project, @asphalt_lot, @core_generation),
            class: "btn btn-primary" %>
      <%= link_to "Export CSV",
            export_csv_project_asphalt_lot_core_generation_path(@project, @asphalt_lot, @core_generation),
            class: "btn btn-outline-primary" %>
    </div>
  </div>

  <% if notice %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <div class="form-card">
    <p class="text-muted mb-4">
      Lot <strong><%= @asphalt_lot.lot_number %></strong>
      &mdash; Seed: <code><%= @core_generation.seed %></code>
      &mdash; <%= @core_locations.size %> core locations
    </p>

    <div class="mb-3">
      <% if @sort_by_sublot %>
        <%= link_to "Sort by Type", project_asphalt_lot_core_generation_path(@project, @asphalt_lot, @core_generation), class: "btn btn-secondary btn-sm" %>
      <% else %>
        <%= link_to "Sort by Sublot", project_asphalt_lot_core_generation_path(@project, @asphalt_lot, @core_generation, sort: "sublot"), class: "btn btn-secondary btn-sm" %>
      <% end %>
    </div>

    <% if @core_locations.any? %>
      <table class="modern-table">
        <thead>
          <tr>
            <th>Mark</th>
            <th>Type</th>
            <th>Sublot</th>
            <th>Lane</th>
            <th>Joint (L-R)</th>
            <th>Lot Dist (ft)</th>
            <th>Sublot Dist (ft)</th>
            <th>Lane Dist (ft)</th>
            <th>Offset (ft)</th>
          </tr>
        </thead>
        <tbody>
          <% current_sublot = nil %>
          <% @core_locations.each do |loc| %>
            <% is_new_sublot = @sort_by_sublot && current_sublot != loc.asphalt_sublot_id %>
            <% current_sublot = loc.asphalt_sublot_id %>
            <tr<%= ' style="border-top: 3px solid var(--border-color);"'.html_safe if is_new_sublot %>>
              <td class="font-bold"><%= loc.mark %></td>
              <td>
                <% if loc.mat? %>
                  <span class="status-badge status-finalize">MAT</span>
                <% else %>
                  <span class="status-badge status-review">JOINT</span>
                <% end %>
              </td>
              <td><%= loc.asphalt_sublot&.position %></td>
              <td><%= loc.lane_index %></td>
              <td>
                <% if loc.joint? %>
                  <code><%= loc.left_lane&.position || loc.left_lane_id %>-<%= loc.right_lane&.position || loc.right_lane_id %></code>
                <% else %>
                  <span class="text-muted">-</span>
                <% end %>
              </td>
              <td class="code-font"><%= number_with_precision(loc.distance_from_lot_start_ft, precision: 2) %></td>
              <td class="code-font"><%= number_with_precision(loc.linear_in_sublot_ft, precision: 2) %></td>
              <td class="code-font"><%= number_with_precision(loc.station_in_lane_ft, precision: 2) %></td>
              <td class="code-font">
                <% if loc.mat? %>
                  <%= number_with_precision(loc.offset_in_lane_ft, precision: 2) %>
                <% else %>
                  <span class="text-muted">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-muted">No core locations were generated.</p>
    <% end %>
  </div>
</div>
