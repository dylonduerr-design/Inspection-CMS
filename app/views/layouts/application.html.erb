<!DOCTYPE html>
<html>
  <head>
    <title>InspectionCms</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <%# PWA Meta Tags %>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2563eb">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="InspectionCMS">
    
    <script type="module">
      import "pwa"
    </script>

  </head>

  <body data-controller="ui offline-indicator">
    
    <%# Offline Indicator %>
    <div class="offline-indicator" data-offline-indicator-target="indicator">
      <div class="offline-indicator__dot"></div>
      <span class="offline-indicator__text">Online</span>
      <span class="offline-indicator__badge d-none" data-offline-indicator-target="badge">0</span>
    </div>
    
    <div id="detective-window" class="detective-window detective-hidden text-mono" data-ui-target="detective">
      <div class="detective-header">
        <h3 class="detective-title">🕵️ Detective Report</h3>
        <button class="detective-close-btn" data-action="click->ui#toggleDetective">✕</button>
      </div>
      
      <div class="detective-grid">
        <div>
          <p><strong>Reports Total:</strong> <%= Report.count %></p>
          <p><strong>View Status:</strong> <%= params[:status] || "All" %></p>
          <p><strong>Controller:</strong> <%= controller_name %>#<%= action_name %></p>
        </div>
        <div>
           <p><strong>User:</strong> <%= user_signed_in? ? current_user.email : "Guest" %></p>
           <code class="detective-code"><%= params.to_json %></code>
        </div>
      </div>
      
      <% if user_signed_in? %>
        <div class="detective-logout">
           <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "detective-button" %>
        </div>
      <% end %>
    </div>

    <%= yield %>

    <%# PWA Install Button %>
    <button id="pwa-install-btn">
      📱 Install App
    </button>

    <div class="floating-actions">
      <button class="float-btn float-btn-accent" title="Debugger" data-action="click->ui#toggleDetective">🐞</button>
      <button id="theme-toggle-btn" class="float-btn float-btn-theme" title="Dark Mode" data-action="click->ui#toggleTheme">🌓</button>
    </div>

  </body>
</html>