<!DOCTYPE html>
<html>
  <head>
    <title>InspectionCms</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600&display=swap">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link rel="icon" href="/favicon.png" type="image/png">

    <%# PWA Meta Tags %>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2563eb">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="InspectionCMS">
    
  </head>

  <body data-controller="ui offline-indicator">
    <% show_debug_metrics = Rails.env.development? %>
    <button id="pwa-install-btn" type="button" aria-label="Install app">
      Install App
    </button>
    
    <div id="detective-window" class="detective-window detective-hidden text-mono" data-ui-target="detective">
      <div class="detective-header">
        <h3 class="detective-title">🕵️ Detective Report</h3>
        <button class="detective-close-btn" data-action="click->ui#toggleDetective">✕</button>
      </div>
      
      <div class="detective-grid">
        <div>
          <p><strong>Reports Total:</strong> <%= show_debug_metrics ? Report.count : "Hidden" %></p>
          <p><strong>View Status:</strong> <%= params[:status] || "All" %></p>
          <p><strong>Controller:</strong> <%= controller_name %>#<%= action_name %></p>
        </div>
        <div>
           <p><strong>User:</strong> <%= user_signed_in? ? current_user.email : "Guest" %></p>
           <% if show_debug_metrics %>
             <code class="detective-code"><%= params.to_unsafe_h.except("controller", "action").to_json %></code>
           <% else %>
             <code class="detective-code">Params hidden outside development</code>
           <% end %>
        </div>
      </div>
      
      <% if user_signed_in? %>
        <div class="detective-logout">
           <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "detective-button" %>
        </div>
      <% end %>
    </div>

    <%= yield %>

  </body>
</html>