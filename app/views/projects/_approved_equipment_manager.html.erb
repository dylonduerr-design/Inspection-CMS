<div class="form-card mt-5">
  <h3>Approved Equipment List</h3>
  <p class="text-muted">Define pre-approved equipment that can be selected from dropdowns in reports.</p>

  <% if project.approved_equipments.any? %>
    <table class="modern-table mb-3">
      <thead>
        <tr>
          <th>Category</th>
          <th>Equipment Name</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% project.approved_equipments.order(:category, :name).each do |equipment| %>
          <tr>
            <td><span class="badge badge-sm"><%= equipment.category || "General Equipment" %></span></td>
            <td><%= equipment.name %></td>
            <td class="text-right">
              <%= button_to "Remove",
                            project_approved_equipment_path(project, equipment),
                            method: :delete,
                            data: { confirm: "Are you sure?" },
                            class: "btn-link text-danger",
                            form: { class: "d-inline" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-muted">No approved equipment defined yet.</p>
  <% end %>

  <%= form_with url: project_approved_equipments_path(project), method: :post, local: true do |f| %>
    <div class="form-row">
      <div class="form-group">
        <%= f.label :category, "Category" %>
        <%= f.select :category, 
                     options_for_select(ApprovedEquipment::CATEGORIES), 
                     { prompt: "Select Category" },
                     { required: true } %>
      </div>
      <div class="form-group flex-2">
        <%= f.label :name, "Equipment Name/Model" %>
        <%= f.text_field :name, placeholder: "e.g., Caterpillar D6 Dozer", required: true %>
      </div>
      <div class="form-group d-flex align-end">
        <%= f.submit "Add Equipment", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
