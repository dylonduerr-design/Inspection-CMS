<div class="nested-entry-card card-accent--green nested-fields mb-2">
  <div class="form-row equipment-row">
    <div class="form-group flex-2">
      <label class="text-muted-sm">Contractor</label>
      <%= f.text_field :contractor, placeholder: "Contractor", class: "auto-contractor w-full" %>
    </div>
    <div class="form-group flex-3">
      <label class="text-muted-sm">Make/Model</label>
      <% 
        # Try to get approved equipment from either the persisted object or from local variable
        approved_equipment_list = if f.object.report&.project&.approved_equipments&.any?
          f.object.report.project.approved_equipments
        elsif defined?(local_approved_equipments) && local_approved_equipments&.any?
          local_approved_equipments
        else
          nil
        end
      %>
      
      <% if approved_equipment_list&.any? %>
        <% approved_names = approved_equipment_list.pluck(:name) %>
        <% current_value = f.object.make_model %>
        <% options = approved_names.map { |name| [name, name] } %>
        <% if current_value.present? && !approved_names.include?(current_value) %>
          <% options = [[current_value, current_value]] + options %>
        <% end %>
        <%= f.select :make_model, 
                     options_for_select(options, current_value),
                     { include_blank: "Select Equipment" },
                     { class: "equipment-select w-full" } %>
      <% else %>
        <%= f.select :make_model,
                     [],
                     { include_blank: "No approved equipment" },
                     { class: "equipment-select w-full", disabled: true } %>
      <% end %>
    </div>
    <div class="form-group flex-05 equipment-compact-field">
      <label class="text-muted-sm">Qty</label>
      <%= f.number_field :quantity, placeholder: "1", class: "w-full" %>
    </div>
    <div class="form-group flex-1 equipment-compact-field">
      <label class="text-muted-sm">Hours</label>
      <%= f.number_field :hours, step: 0.5, placeholder: "Hrs", class: "w-full" %>
    </div>
    
    <div class="form-group d-flex align-end">
      <% if f.object.persisted? %>
        <div class="d-none"><%= f.check_box :_destroy %></div>
      <% end %>
      
            <button type="button" class="remove-row-btn inline-danger mb-2" 
              data-action="click->report-form#removeAssociation">
        Delete
      </button>
    </div>
  </div>
</div>