<div class="nested-entry-card card-accent--green nested-fields mb-3">
  
  <div class="form-row mb-2">
     <div class="form-group flex-2">
       <label>Contractor</label>
       <%= f.text_field :contractor, placeholder: "Contractor Name", class: "auto-contractor" %>
     </div>
     
     <div class="form-group d-flex align-end">
       <% if f.object.persisted? %>
         <div class="d-none"><%= f.check_box :_destroy %></div>
       <% end %>

       <button type="button" class="remove-row-btn inline-danger" 
               data-action="click->report-form#removeAssociation">
         Delete
       </button>
     </div>
  </div>

  <div class="form-row form-row--compact">
     <div class="form-group form-group--count">
       <label class="text-sm">Supt</label>
       <%= f.number_field :superintendent_count, placeholder: "0" %>
     </div>
     
     <div class="form-group form-group--count">
       <label class="text-sm">Foreman</label>
       <%= f.number_field :foreman_count, placeholder: "0" %>
     </div>
     
     <div class="form-group form-group--count">
       <label class="text-sm">Survey</label>
       <%= f.number_field :survey_count, placeholder: "0" %>
     </div>
     
     <div class="form-group form-group--count">
       <label class="text-sm">Operators</label>
       <%= f.number_field :operator_count, placeholder: "0" %>
     </div>
     
     <div class="form-group form-group--count">
       <label class="text-sm">Laborers</label>
       <%= f.number_field :laborer_count, placeholder: "0" %>
     </div>
     
     <div class="form-group form-group--count">
       <label class="text-sm">Electricians</label>
       <%= f.number_field :electrician_count, placeholder: "0" %>
     </div>
  </div>

</div>
