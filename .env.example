# Environment Configuration for Inspection CMS

# Azure OpenAI Configuration (do not put real secrets in this file)
# NOTE: endpoint should be the base resource URL (no /openai/... path, no api-version query)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-nano
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# .NET Document Exporter Service
# When running with docker-compose, use the service name: http://docx-exporter:5000
# When running Rails locally with exporter in docker: http://localhost:5050
DOTNET_EXPORTER_URL=http://docx-exporter:5000

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Database Configuration (if using Docker PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/inspection_cms_development

# Microsoft Entra ID (Azure AD) SSO — leave blank to disable SSO login
# Get these values from your IT admin after they create the App Registration.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
