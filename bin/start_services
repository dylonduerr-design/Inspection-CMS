#!/bin/bash

set -euo pipefail

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$APP_ROOT"

# Check if Redis is running
if ! command -v redis-cli &> /dev/null; then
    echo "Error: redis-cli not found. Is Redis installed?"
    exit 1
fi

if ! command -v bundle &> /dev/null; then
    echo "Error: bundle not found. Is Bundler installed?"
    exit 1
fi

echo "Checking Redis status..."
if redis-cli ping > /dev/null 2>&1; then
    echo "Redis is already running."
else
    echo "Redis is not running. Starting Redis..."
    # Try to start as daemon first (if config allows), otherwise background it
    if redis-server --daemonize yes 2>/dev/null; then
        echo "Redis started (daemonized)."
    else
        echo "Could not daemonize, starting in background..."
        redis-server &
    fi
    
    # Wait a moment for it to come up
    sleep 1
fi

if pgrep -f "sidekiq" > /dev/null; then
    echo "Sidekiq is already running."
    exit 0
fi

echo "Starting Sidekiq..."
mkdir -p "$APP_ROOT/tmp/pids"

RAILS_ENV="${RAILS_ENV:-development}"
nohup bundle exec sidekiq -e "$RAILS_ENV" -r "$APP_ROOT" > "$APP_ROOT/log/sidekiq.out" 2>&1 &

echo "Sidekiq started (PID $!). Logs: log/sidekiq.log (stdout: log/sidekiq.out)"
