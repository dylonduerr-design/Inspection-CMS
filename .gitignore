# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore env files (keep local secrets out of git), but allow templates.
/.env
/.env.*
!/.env.example
!/.env*.erb

# Runtime/Generated directories (keep locally, do not commit)
/log/
/tmp/
/storage/

# If you’re not maintaining a Rails test suite in this repo, keep it untracked.
/test/

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Rails encrypted credentials keys (multi-environment)
/config/credentials/*.key

# Private keys / cert bundles (avoid accidental commits)
*.pem
*.p12
*.pfx
*.key

# Local dev databases
/db/*.sqlite3
/db/*.sqlite3-*

# Python virtual environment
.venv/
/python/venv/
/python/.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# Accidental/Generated artifacts
/inspection_test_output.docx
/e
